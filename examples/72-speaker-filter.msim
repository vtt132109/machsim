        {
          "id": "note1_sheet1",
          "x": 60,
          "y": 480,
          "text": "Loa LS1 phát điện áp ở ngõ ra mạch đệm. V1 (440 Hz) đi qua gần như nguyên vẹn; V2 (3 kHz) bị giảm còn khoảng 47 %.",
          "size": 11
        },
        {
          "id": "note2_sheet1",
          "x": 60,
          "y": 500,
          "text": "Mở Mô phỏng › Âm thanh để chỉnh âm lượng chung, tắt tiếng và xem vạch mức. Nếu mạch chạy chậm hơn thời gian thực, cửa sổ sẽ báo âm thanh bị kéo giãn.",
          "size": 11
        }
      ]
    }
