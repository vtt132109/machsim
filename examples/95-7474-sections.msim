      "notes": [
        {
          "id": "note1_sheet1",
          "x": 60,
          "y": 420,
          "text": "D = QN biến mỗi flip-flop thành bộ chia 2: Q1 = f/2 = 500 Hz, Q2 = f/4 = 250 Hz. Hai bộ chia hợp lại là bộ đếm nhị phân 2 bit.",
          "size": 11
        },
        {
          "id": "note2_sheet1",
          "x": 60,
          "y": 440,
          "text": "U1A và U1B là cùng một vi mạch (cùng tên U1). Dùng Thuộc tính › Vi mạch để chuyển một phần sang chip khác hoặc sang một chip mới.",
          "size": 11
        }
      ]
    }
