        {
          "id": "p5",
          "partId": "misc-digital/mcu-8051-p1",
          "refdes": "U1",
          "x": 380,
          "y": 260,
          "rotation": 0,
          "mirror": false,
          "params": {
            "program": "; Doc nut nhan o P1.2, dao LED o P1.0\n        ORG  0\n        SETB P1.0           ; LED tat (muc 1)\nWAIT:   JB   P1.2,WAIT      ; cho tai khi nut keo chan xuong 0\n        ACALL DELAY20       ; chong doi\n        JB   P1.2,WAIT      ; con nhieu thi bo qua\n        CPL  P1.0           ; dao LED\nREL:    JNB  P1.2,REL       ; cho nha nut\n        ACALL DELAY20\n        SJMP WAIT\n\nDELAY20: MOV R7,#40         ; 40 x 503 chu ky = 20120 us\nD1:     MOV  R6,#250\nD2:     DJNZ R6,D2\n        DJNZ R7,D1\n        RET\n        END",
            "fosc": "12M"
          }
        },
        {
          "id": "p6",
          "partId": "basic/push-button",
          "refdes": "S1",
          "x": 220,
          "y": 360,
          "rotation": 90,
          "mirror": false,
          "params": {
            "key": "Space"
          }
        },
