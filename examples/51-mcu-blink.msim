  "version": 2,
  "title": "Blink an LED with an 8051",
  "sheets": [
    {
      "id": "sheet1",
      "name": "Sheet 1",
      "parts": [
        {
          "id": "p1",
          "partId": "sources/dc-voltage",
          "refdes": "V1",
          "x": 100,
          "y": 260,
          "rotation": 0,
          "mirror": false,
          "params": {
            "value": "5"
          }
        },
        {
          "id": "p2",
          "partId": "sources/ground",
          "refdes": "GND1",
          "x": 100,
          "y": 340,
          "rotation": 0,
          "mirror": false,
          "params": {}
        },
        {
          "id": "p5",
          "partId": "misc-digital/mcu-8051-p1",
          "refdes": "U1",
          "x": 360,
          "y": 260,
          "rotation": 0,
          "mirror": false,
          "params": {
            "program": "; Nhay LED o chan P1.0\n        ORG  0\nMAIN:   CPL  P1.0          ; dao trang thai chan\n        ACALL DELAY\n        SJMP MAIN\n\nDELAY:  MOV  R7,#200       ; 200 x 503 chu ky may = 100600 us\nD1:     MOV  R6,#250\nD2:     DJNZ R6,D2\n        DJNZ R7,D1\n        RET\n        END",
            "fosc": "12M"
          }
        },
        {
          "id": "p6",
          "partId": "basic/resistor",
          "refdes": "R1",
          "x": 560,
          "y": 180,
          "rotation": 0,
          "mirror": false,
          "params": {
            "value": "330"
          }
        },
        {
          "id": "p7",
          "partId": "diodes/led-red",
          "refdes": "LED1",
          "x": 660,
          "y": 240,
          "rotation": 90,
          "mirror": false,
          "params": {}
        }
