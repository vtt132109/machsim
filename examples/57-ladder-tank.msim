            "kind": "series",
            "items": [
              {
                "kind": "contact",
                "type": "nc",
                "address": "I0.1"
              },
              {
                "kind": "parallel",
                "items": [
                  {
                    "kind": "contact",
                    "type": "nc",
                    "address": "I0.0"
                  },
                  {
                    "kind": "contact",
                    "type": "no",
                    "address": "Q0.0"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "rung2",
          "comment": "Báo động gần tràn: cảm biến mức trên 9,5 V",
          "outputs": [
            {
              "kind": "coil",
              "address": "Q0.2"
            }
          ],
          "logic": {
            "kind": "compare",
            "op": "gt",
            "left": "AI0",
            "right": "9.5"
          }
        }
      ]
    }
