      "name": "Ladder 1",
      "parts": [],
      "wires": [],
      "labels": [],
      "probes": [],
      "notes": [],
      "kind": "ladder",
      "ladder": [
        {
          "id": "rung1",
          "comment": "Bơm: chạy khi nước dưới mức thấp, tự giữ tới khi tới mức cao",
          "outputs": [
            {
              "kind": "coil",
              "address": "Q0.0"
            }
          ],
