      "notes": [
        {
          "id": "n1",
          "x": 60,
          "y": 520,
          "text": "Mỗi lần gửi: đặt RS và 4 bit dữ liệu, đưa E lên rồi xuống (LCD chốt ở sườn xuống của E). Byte gửi nửa cao trước. Lệnh: 0x28 = 4 bit, 2 dòng; 0x0C = bật hiển thị; 0x01 = xoá; 0x06 = tự tăng địa chỉ; 0xC0 = đầu dòng 2.",
          "size": 11
        }
      ]
