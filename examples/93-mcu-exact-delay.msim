          "id": "p1",
          "partId": "sources/dc-voltage",
          "refdes": "V1",
          "x": 100,
          "y": 260,
          "rotation": 0,
          "mirror": false,
          "params": {
            "value": "5"
          }
        },
        {
          "id": "p4",
          "partId": "misc-digital/mcu-8051-p1",
          "refdes": "U1",
          "x": 360,
          "y": 260,
          "rotation": 0,
          "mirror": false,
          "params": {
            "program": "; P1.0 doi trang thai sau dung 1000 chu ky may / toggle P1.0 every 1000 machine cycles\n        ORG  0\nMAIN:   CPL  P1.0          ; 1 chu ky\n        ACALL DELAY        ; 2 chu ky\n        SJMP MAIN          ; 2 chu ky\n\nDELAY:  MOV  R7,#32        ; 1 chu ky\nD1:     MOV  R6,#14        ; 1 chu ky\nD2:     DJNZ R6,D2         ; 2 chu ky, lap 14 lan\n        DJNZ R7,D1         ; 2 chu ky, lap 32 lan\n        RET                ; 2 chu ky\n        END",
            "fosc": "12M"
          }
        },
        {
          "id": "p5",
          "partId": "basic/resistor",
          "refdes": "R1",
          "x": 560,
          "y": 180,
          "rotation": 0,
          "mirror": false,
          "params": {
            "value": "330"
          }
        },
        {
