      "notes": [
        {
          "id": "note1_sheet2",
          "x": 60,
          "y": 340,
          "text": "Mạch lực: tiếp điểm chính KC3 (theo cuộn KM1 ở trang Điều khiển) → rơ-le nhiệt FR1 (1 A, cấp 10A) → tải RM 2 Ω = động cơ bị kẹt (6 A).",
          "size": 11
        },
        {
          "id": "note2_sheet2",
          "x": 60,
          "y": 360,
          "text": "Cùng một tên “KM1” nối cuộn với tiếp điểm dù chúng ở hai trang khác nhau. Nhấn R (Reset) để đặt lại rơ-le nhiệt.",
          "size": 11
        }
      ]
