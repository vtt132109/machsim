      "notes": [
        {
          "id": "note1_sheet1",
          "x": 60,
          "y": 340,
          "text": "Điều khiển 24 V: Dừng (S2, thường đóng, phím X) → Mở (S1, phím G) song song tiếp điểm tự giữ KC1 (cuộn KM1) → tiếp điểm rơ-le nhiệt 95-96 → cuộn KM1.",
          "size": 11
        },
        {
          "id": "note2_sheet1",
          "x": 60,
          "y": 360,
          "text": "Đèn X1 sáng khi cuộn KM1 có điện. Rơ-le nhiệt FR1 nằm ở trang “Mạch lực”.",
          "size": 11
        }
      ]
    },
