        {
          "id": "p5",
          "partId": "misc-digital/mcu-8051-p1",
          "refdes": "U1",
          "x": 380,
          "y": 260,
          "rotation": 0,
          "mirror": false,
          "params": {
            "program": "; Gui \"Hello MachSim\" roi phat lai nhung gi nhan duoc, 9600 baud\n        ORG  0\n        MOV  TMOD,#20h      ; Timer 1 che do 2 (tu nap lai)\n        MOV  TH1,#0FDh      ; 9600 baud voi thach anh 11,0592 MHz\n        MOV  TL1,#0FDh\n        SETB TR1\n        MOV  SCON,#50h      ; UART 8 bit, cho phep nhan\n        MOV  DPTR,#MSG\nSEND:   CLR  A\n        MOVC A,@A+DPTR\n        JZ   ECHO           ; ket thuc chuoi\n        ACALL PUTC\n        INC  DPTR\n        SJMP SEND\n\nECHO:   JNB  RI,ECHO        ; cho mot byte tu cua so noi tiep\n        CLR  RI\n        MOV  A,SBUF\n        ACALL PUTC\n        SJMP ECHO\n\nPUTC:   MOV  SBUF,A\nTXW:    JNB  TI,TXW\n        CLR  TI\n        RET\n\nMSG:    DB   'Hello MachSim',0Dh,0Ah,0\n        END",
            "fosc": "11.0592M"
          }
        },
        {
          "id": "p6",
          "partId": "basic/resistor",
          "refdes": "R1",
          "x": 620,
          "y": 220,
          "rotation": 0,
          "mirror": false,
          "params": {
            "value": "4.7k"
          }
        }
      ],
