          "id": "p1",
          "partId": "sources/dc-voltage",
          "refdes": "V1",
          "x": 100,
          "y": 300,
          "rotation": 0,
          "mirror": false,
          "params": {
            "value": "5"
          }
        },
        {
          "id": "p2",
          "partId": "sources/ground",
          "refdes": "GND1",
          "x": 100,
          "y": 380,
          "rotation": 0,
          "mirror": false,
          "params": {}
        },
        {
          "id": "p5",
          "partId": "misc-digital/mcu-8051-p1",
          "refdes": "U1",
          "x": 340,
          "y": 280,
          "rotation": 0,
          "mirror": false,
          "params": {
            "program": "; Dem 0..9 ra LED 7 doan anode chung tren P1\nTICKS   EQU  30h            ; so lan ngat con lai\nDIGIT   EQU  31h            ; chu so dang hien\n        ORG  0\n        LJMP MAIN\n        ORG  0Bh            ; vec-to Timer 0\n        LJMP T0ISR\n\n        ORG  30h\nMAIN:   MOV  SP,#60h\n        MOV  TMOD,#01h      ; Timer 0, che do 1 (16 bit)\n        MOV  TH0,#3Ch       ; 65536 - 50000 = 15536 = 3CB0h\n        MOV  TL0,#0B0h\n        MOV  IE,#82h        ; EA + ET0\n        SETB TR0\n        MOV  TICKS,#10\n        MOV  DIGIT,#0\n        ACALL SHOW\nLOOP:   SJMP LOOP\n\nT0ISR:  MOV  TH0,#3Ch       ; nap lai 50 ms\n        MOV  TL0,#0B0h\n        DJNZ TICKS,DONE\n        MOV  TICKS,#10      ; 10 x 50 ms = 0,5 s\n        MOV  A,DIGIT\n        INC  A\n        CJNE A,#10,KEEP\n        MOV  A,#0\nKEEP:   MOV  DIGIT,A\n        ACALL SHOW\nDONE:   RETI\n\nSHOW:   MOV  A,DIGIT        ; tra bang ma 7 doan\n        MOV  DPTR,#TABLE\n        MOVC A,@A+DPTR\n        MOV  P1,A\n        RET\n\n; bit 0 = a ... bit 6 = g, muc 0 la sang (anode chung)\nTABLE:  DB   0C0h,0F9h,0A4h,0B0h,99h\n        DB   92h,82h,0F8h,80h,90h\n        END",
            "fosc": "12M"
          }
        },
