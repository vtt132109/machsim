    {
      "id": "sheet2",
      "name": "Ladder 1",
      "parts": [],
      "wires": [],
      "labels": [],
      "probes": [],
      "notes": [],
      "kind": "ladder",
      "ladder": [
        {
          "id": "rung1",
          "comment": "Bơm: gọi khối BomHaiMuc, nối mức thấp I0.0, mức cao I0.1 và cuộn dây Q0.0",
          "outputs": [
            {
              "kind": "call",
              "address": "P1",
              "block": "BomHaiMuc",
              "args": {
                "MUCTHAP": "I0.0",
                "MUCCAO": "I0.1",
                "BOM": "Q0.0"
              }
            }
          ]
        },
        {
          "id": "rung2",
          "comment": "Đồng hồ mức: AQ0 = AI0 × 0,5 (bồn đầy 10 V cho 5 V)",
          "outputs": [
            {
              "kind": "mul",
              "address": "AQ0",
              "a": "AI0",
              "b": "0.5"
            }
          ]
        },
        {
          "id": "rung3",
          "comment": "Đếm số lần bơm khởi động: sườn lên của Q0.0 cộng 1 vào MW0",
          "outputs": [
            {
              "kind": "add",
              "address": "MW0",
              "a": "MW0",
              "b": "1"
            }
          ],
          "logic": {
            "kind": "contact",
            "type": "rising",
            "address": "Q0.0"
          }
        },
        {
          "id": "rung4",
          "comment": "Báo bơm đã khởi động từ 2 lần trở lên",
          "outputs": [
            {
              "kind": "coil",
              "address": "Q0.2"
            }
          ],
          "logic": {
            "kind": "compare",
            "op": "ge",
            "left": "MW0",
            "right": "2"
          }
        }
      ]
    }
  ],
  "analysis": {
    "active": "tran",
    "specs": {
      "op": {
        "type": "op"
      },
      "tran": {
        "type": "tran",
        "tstep": 0.1,
        "tstop": 25
      }
    }
  },
  "options": {},
  "variables": {},
  "description": "Cùng bồn nước của mẫu 57, viết gọn hơn bằng ba thứ mới của sơ đồ bậc thang. (1) KHỐI HÀM “BomHaiMuc”: bài toán bơm tự giữ giữa hai công tắc phao được viết MỘT lần (nhấn “Khối hàm” trên thanh công cụ của trang bậc thang để xem), bậc 1 chỉ gọi nó và nối ba tham số với I0.0, I0.1 và Q0.0. Muốn thêm một bồn thứ hai, chỉ cần gọi khối lần nữa. (2) LỆNH SỐ: bậc 2 là MUL AQ0 = AI0 × 0,5 (đồng hồ mức 0 … 5 V), bậc 3 dùng tiếp điểm SƯỜN LÊN của Q0.0 để ADD MW0 = MW0 + 1 mỗi lần bơm khởi động, bậc 4 so sánh MW0 ≥ 2 để báo bơm khởi động lại. (3) NGÕ RA TƯƠNG TỰ: mô-đun AQ đưa điện áp của AQ0 ra chân GAUGE; bồn đầy 80 % thì mức là 8 V và đồng hồ chỉ 4 V. Nhấn Chạy (F5); sau 16 s bơm nghỉ. Nhấp công tắc S1 (phím V) để xả nước, bơm chạy lại và đèn báo sáng ở lần khởi động thứ hai. Nhấn “Tham chiếu chéo” để thấy MW0 được ghi ở bậc 3 và đọc ở bậc 4. The tank of sample 57, written more compactly with three new things of the ladder editor. (1) A FUNCTION BLOCK “BomHaiMuc”: the self-holding pump between the two float switches is written ONCE (press “Function blocks” on the ladder sheet’s toolbar to see it); rung 1 only calls it and ties three parameters to I0.0, I0.1 and Q0.0. A second tank needs only another call. (2) WORD INSTRUCTIONS: rung 2 is MUL AQ0 = AI0 × 0.5 (a level gauge of 0 … 5 V), rung 3 uses a RISING-EDGE contact of Q0.0 to ADD MW0 = MW0 + 1 each time the pump starts, rung 4 compares MW0 ≥ 2 to flag a pump that restarted. (3) AN ANALOG OUTPUT: the AQ module drives the voltage of AQ0 onto the pin GAUGE; with the tank 80 % full the level is 8 V and the gauge reads 4 V. Press Run (F5); after 16 s the pump rests. Click switch S1 (key V) to drain the tank, the pump starts again and the alarm lamp lights on the second start. Press “Cross-reference” to see MW0 written in rung 3 and read in rung 4.",
  "ladderBlocks": [
    {
      "id": "blk-pump",
      "name": "BomHaiMuc",
      "comment": "Bơm tự giữ giữa hai công tắc phao: chạy khi nước dưới mức thấp, nghỉ khi tới mức cao",
      "inputs": [
        "MUCTHAP",
        "MUCCAO"
      ],
      "outputs": [
        "BOM"
      ],
      "rungs": [
        {
          "id": "blk-pump-1",
          "comment": "Tự giữ: (nước dưới mức thấp HOẶC đang bơm) VÀ chưa tới mức cao → bơm",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "contact",
                "type": "nc",
                "address": "MUCCAO"
              },
              {
                "kind": "parallel",
                "items": [
                  {
                    "kind": "contact",
                    "type": "nc",
                    "address": "MUCTHAP"
                  },
                  {
                    "kind": "contact",
                    "type": "no",
                    "address": "BOM"
                  }
                ]
              }
            ]
          },
          "outputs": [
            {
              "kind": "coil",
              "address": "BOM"
            }
          ]
        }
      ]
    }
  ]
}