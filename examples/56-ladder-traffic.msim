      "notes": [],
      "kind": "ladder",
      "ladder": [
        {
          "id": "rung1",
          "comment": "Bộ định thời vòng: T1 đếm 20 s rồi tự xoá để bắt đầu lại",
          "outputs": [
            {
              "kind": "ton",
              "address": "T1",
              "preset": "20"
            }
          ],
          "logic": {
            "kind": "contact",
            "type": "nc",
            "address": "T1"
          }
        },
        {
          "id": "rung2",
          "comment": "0–8 s: Bắc–Nam xanh",
          "outputs": [
            {
              "kind": "coil",
              "address": "Q0.2"
            }
          ],
          "logic": {
            "kind": "compare",
            "op": "lt",
            "left": "T1.ET",
            "right": "8"
          }
        },
        {
          "id": "rung3",
          "comment": "8–10 s: Bắc–Nam vàng",
          "outputs": [
            {
              "kind": "coil",
              "address": "Q0.1"
            }
          ],
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "compare",
                "op": "ge",
                "left": "T1.ET",
                "right": "8"
              },
              {
                "kind": "compare",
                "op": "lt",
                "left": "T1.ET",
                "right": "10"
              }
            ]
          }
        },
        {
          "id": "rung4",
          "comment": "Từ 10 s: Bắc–Nam đỏ",
          "outputs": [
            {
              "kind": "coil",
              "address": "Q0.0"
            }
          ],
          "logic": {
            "kind": "compare",
            "op": "ge",
            "left": "T1.ET",
            "right": "10"
          }
        },
        {
          "id": "rung5",
          "comment": "0–10 s: Đông–Tây đỏ",
          "outputs": [
            {
              "kind": "coil",
              "address": "Q0.3"
            }
          ],
          "logic": {
            "kind": "compare",
            "op": "lt",
            "left": "T1.ET",
            "right": "10"
          }
        },
        {
          "id": "rung6",
          "comment": "10–18 s: Đông–Tây xanh",
          "outputs": [
            {
              "kind": "coil",
              "address": "Q0.5"
            }
          ],
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "compare",
                "op": "ge",
                "left": "T1.ET",
                "right": "10"
              },
              {
                "kind": "compare",
                "op": "lt",
                "left": "T1.ET",
                "right": "18"
              }
            ]
          }
        },
        {
          "id": "rung7",
          "comment": "Từ 18 s: Đông–Tây vàng",
          "outputs": [
            {
              "kind": "coil",
              "address": "Q0.4"
            }
          ],
          "logic": {
            "kind": "compare",
            "op": "ge",
            "left": "T1.ET",
            "right": "18"
